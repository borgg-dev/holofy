# Automatic HTTPS for your domain (Caddy fetches + renews a Let's Encrypt cert on its own).
# Serves the Privacy Policy and Terms as static pages, and reverse-proxies everything else to
# the API. The mobile app talks to https://YOUR_DOMAIN/… — auth, scan, collection, etc.

{$HOLOFY_DOMAIN} {
	encode gzip

	# Hard cap on request bodies at the edge — a capture is at most a handful of phone stills.
	# Bounds memory before a request reaches the app (8 images × 12 MB ≈ 96 MB, plus slack).
	request_body {
		max_size 110MB
	}

	# Static legal pages (Google Play needs a Privacy Policy URL; both are plain HTML).
	handle /privacy {
		rewrite * /privacy.html
		root * /srv/legal
		file_server
	}
	handle /terms {
		rewrite * /terms.html
		root * /srv/legal
		file_server
	}

	# Everything else is the API.
	handle {
		reverse_proxy api:8000
	}
}
