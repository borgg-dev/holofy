{
  "$meta": {
    "name": "Holofy — Foil Vault tokens",
    "version": "0.1.0",
    "description": "Single source of truth for the Holofy design system. Edit here; tokens.ts and tokens.css are generated from this file by build.mjs.",
    "principles": [
      "Vault surfaces are calm and near-black — that is where money and trust live.",
      "Foil is scarce. It is a reward (reveal, rare pull, milestone), never wallpaper.",
      "Prices and grades use tabular figures so digits never shift.",
      "Motion is purposeful and short; it can always be turned off."
    ]
  },

  "color": {
    "brand": {
      "holoViolet": { "value": "#6C3CE0", "comment": "Primary brand. Actions, focus, the spine of the foil sweep." },
      "foilMagenta": { "value": "#FF4FD8", "comment": "Reward accent. Reveal moments and rare-pull energy." },
      "vaultTeal": { "value": "#23D5C7", "comment": "Capture-lock + healthy/verified signal." },
      "nearBlack": { "value": "#0B0B12", "comment": "The Vault. Deepest surface." }
    },

    "violet": {
      "50":  { "value": "#F2EDFE" },
      "100": { "value": "#E2D6FC" },
      "200": { "value": "#C7AEF8" },
      "300": { "value": "#A985F2" },
      "400": { "value": "#8C5DEC" },
      "500": { "value": "#6C3CE0", "comment": "= brand.holoViolet" },
      "600": { "value": "#5A2EC4" },
      "700": { "value": "#48249E" },
      "800": { "value": "#361B77" },
      "900": { "value": "#241350" }
    },
    "magenta": {
      "50":  { "value": "#FFEBFB" },
      "100": { "value": "#FFD2F5" },
      "200": { "value": "#FFA8EC" },
      "300": { "value": "#FF7BE2" },
      "400": { "value": "#FF4FD8", "comment": "= brand.foilMagenta" },
      "500": { "value": "#E635BE" },
      "600": { "value": "#BC2A9B" },
      "700": { "value": "#921F78" },
      "800": { "value": "#681555" },
      "900": { "value": "#3F0B33" }
    },
    "teal": {
      "50":  { "value": "#E1FBF8" },
      "100": { "value": "#BAF5EF" },
      "200": { "value": "#86ECE2" },
      "300": { "value": "#4FE0D2" },
      "400": { "value": "#23D5C7", "comment": "= brand.vaultTeal" },
      "500": { "value": "#16B3A7" },
      "600": { "value": "#0F8C83" },
      "700": { "value": "#0A6661" },
      "800": { "value": "#06433F" },
      "900": { "value": "#03211F" }
    },

    "neutral": {
      "0":   { "value": "#0B0B12", "comment": "Vault base — deepest." },
      "50":  { "value": "#11111B" },
      "100": { "value": "#16161F" },
      "150": { "value": "#1C1C28" },
      "200": { "value": "#23232F" },
      "300": { "value": "#2E2E3C" },
      "400": { "value": "#3C3C4E" },
      "500": { "value": "#55556B" },
      "600": { "value": "#74748C" },
      "700": { "value": "#9A9AB0" },
      "800": { "value": "#C4C4D4" },
      "900": { "value": "#E6E6F0" },
      "1000": { "value": "#FFFFFF" }
    },

    "support": {
      "amber":    { "value": "#F5B43C", "comment": "Caution / seek-review. Never used as a binary 'fake' red." },
      "amberSoft":{ "value": "#5C4216" },
      "red":      { "value": "#E5484D", "comment": "System errors only — capture failure, network. Not authenticity verdicts." },
      "redSoft":  { "value": "#4A1A1C" },
      "green":    { "value": "#23D5C7", "comment": "Positive = vault teal, deliberately not Pokémon green." }
    },

    "semantic": {
      "dark": {
        "bg":            { "value": "{color.neutral.0}",   "comment": "App background — the Vault." },
        "bgElevated":    { "value": "{color.neutral.100}", "comment": "Cards, sheets." },
        "bgRaised":      { "value": "{color.neutral.150}", "comment": "Hover/raised within a card." },
        "bgInset":       { "value": "{color.neutral.50}",  "comment": "Wells, inputs, recessed areas." },
        "border":        { "value": "{color.neutral.300}" },
        "borderStrong":  { "value": "{color.neutral.400}" },
        "textPrimary":   { "value": "{color.neutral.1000}" },
        "textSecondary": { "value": "{color.neutral.800}" },
        "textTertiary":  { "value": "{color.neutral.600}" },
        "textOnAccent":  { "value": "#FFFFFF" },
        "accent":        { "value": "{color.brand.holoViolet}" },
        "accentHover":   { "value": "{color.violet.400}" },
        "accentPressed": { "value": "{color.violet.600}" },
        "reward":        { "value": "{color.brand.foilMagenta}" },
        "lock":          { "value": "{color.brand.vaultTeal}" },
        "focusRing":     { "value": "{color.violet.300}" }
      },
      "light": {
        "bg":            { "value": "#FBFAFF",            "comment": "Light is a faithful inversion; the foil still reads on it." },
        "bgElevated":    { "value": "#FFFFFF" },
        "bgRaised":      { "value": "#F4F2FB" },
        "bgInset":       { "value": "#F0EEF8" },
        "border":        { "value": "#E2DFF0" },
        "borderStrong":  { "value": "#CDC8E4" },
        "textPrimary":   { "value": "#14121F" },
        "textSecondary": { "value": "#4A4760" },
        "textTertiary":  { "value": "#6E6A85" },
        "textOnAccent":  { "value": "#FFFFFF" },
        "accent":        { "value": "{color.violet.600}" },
        "accentHover":   { "value": "{color.brand.holoViolet}" },
        "accentPressed": { "value": "{color.violet.700}" },
        "reward":        { "value": "{color.magenta.500}" },
        "lock":          { "value": "{color.teal.600}" },
        "focusRing":     { "value": "{color.violet.400}" }
      }
    }
  },

  "gradient": {
    "foilSweep": {
      "value": "conic-gradient(from var(--foil-angle, 210deg) at 50% 50%, #6C3CE0 0deg, #23D5C7 72deg, #FF4FD8 150deg, #6C3CE0 230deg, #23D5C7 300deg, #FF4FD8 360deg)",
      "comment": "The signature. A gyroscope/pointer-reactive conic sweep through the three brand hues. --foil-angle is driven by tilt/scroll. Use sparingly."
    },
    "foilSheen": {
      "value": "linear-gradient(115deg, transparent 0%, rgba(255,255,255,0.0) 38%, rgba(255,255,255,0.55) 50%, rgba(255,255,255,0.0) 62%, transparent 100%)",
      "comment": "The traveling specular highlight swept across a revealed foil card."
    },
    "vaultDepth": {
      "value": "radial-gradient(120% 100% at 50% -10%, #1A1530 0%, #0B0B12 60%)",
      "comment": "Subtle violet-tinted depth on the Vault background; not a flat black." }
    ,
    "lockGlow": {
      "value": "radial-gradient(60% 60% at 50% 50%, rgba(35,213,199,0.28) 0%, rgba(35,213,199,0) 70%)",
      "comment": "Teal aura behind the capture-lock frame when quality is met." }
  },

  "typography": {
    "family": {
      "display": { "value": "'Clash Display', 'Manrope', system-ui, sans-serif", "comment": "Headlines, big numerics, the reveal value." },
      "text":    { "value": "'Manrope', system-ui, -apple-system, sans-serif", "comment": "All UI, body, labels." },
      "mono":    { "value": "'Manrope', ui-monospace, monospace", "comment": "Manrope carries tabular figures; reserved fallback." }
    },
    "weight": {
      "regular":  { "value": "400" },
      "medium":   { "value": "500" },
      "semibold": { "value": "600" },
      "bold":     { "value": "700" }
    },
    "feature": {
      "tabular": { "value": "'tnum' 1, 'lnum' 1", "comment": "font-feature-settings for prices, grades, counters — digits never shift width." }
    },
    "scale": {
      "displayXl": { "value": { "size": 56, "lineHeight": 56, "weight": 600, "tracking": -1.5, "family": "display" }, "comment": "Reveal value / hero." },
      "displayLg": { "value": { "size": 40, "lineHeight": 44, "weight": 600, "tracking": -1.0, "family": "display" } },
      "displayMd": { "value": { "size": 30, "lineHeight": 36, "weight": 600, "tracking": -0.5, "family": "display" } },
      "titleLg":   { "value": { "size": 22, "lineHeight": 28, "weight": 600, "tracking": -0.2, "family": "text" } },
      "titleMd":   { "value": { "size": 18, "lineHeight": 24, "weight": 600, "tracking": -0.1, "family": "text" } },
      "body":      { "value": { "size": 16, "lineHeight": 24, "weight": 400, "tracking": 0, "family": "text" } },
      "bodySm":    { "value": { "size": 14, "lineHeight": 20, "weight": 400, "tracking": 0, "family": "text" } },
      "label":     { "value": { "size": 13, "lineHeight": 16, "weight": 600, "tracking": 0.2, "family": "text" } },
      "caption":   { "value": { "size": 12, "lineHeight": 16, "weight": 500, "tracking": 0.2, "family": "text" } },
      "overline":  { "value": { "size": 11, "lineHeight": 12, "weight": 600, "tracking": 1.4, "family": "text" }, "comment": "All-caps eyebrows; the small structural labels." }
    }
  },

  "space": {
    "0":  { "value": 0 },
    "1":  { "value": 2 },
    "2":  { "value": 4 },
    "3":  { "value": 8 },
    "4":  { "value": 12 },
    "5":  { "value": 16 },
    "6":  { "value": 20 },
    "7":  { "value": 24 },
    "8":  { "value": 32 },
    "9":  { "value": 40 },
    "10": { "value": 48 },
    "11": { "value": 64 },
    "12": { "value": 80 },
    "13": { "value": 96 }
  },

  "radius": {
    "xs":   { "value": 6 },
    "sm":   { "value": 10 },
    "md":   { "value": 14 },
    "lg":   { "value": 20 },
    "xl":   { "value": 28 },
    "card": { "value": 18, "comment": "Trading-card corner ratio at our standard card size." },
    "pill": { "value": 999 }
  },

  "elevation": {
    "0": { "value": "none" },
    "1": { "value": "0 1px 2px rgba(0,0,0,0.40)" },
    "2": { "value": "0 4px 16px rgba(0,0,0,0.45)" },
    "3": { "value": "0 12px 32px rgba(0,0,0,0.55)" },
    "foil": { "value": "0 18px 50px rgba(108,60,224,0.35), 0 4px 14px rgba(255,79,216,0.18)", "comment": "The lifted, lit glow under a revealed foil card." }
  },

  "motion": {
    "duration": {
      "instant": { "value": 80 },
      "fast":    { "value": 140 },
      "base":    { "value": 220 },
      "slow":    { "value": 360 },
      "reveal":  { "value": 900, "comment": "The foil reveal count-up + sweep." },
      "countUp": { "value": 1100, "comment": "Value odometer roll." }
    },
    "easing": {
      "standard": { "value": "cubic-bezier(0.2, 0, 0, 1)", "comment": "Default in/out for most transitions." },
      "entrance": { "value": "cubic-bezier(0.16, 1, 0.3, 1)", "comment": "Decelerate-in for things arriving (reveal, sheets)." },
      "exit":     { "value": "cubic-bezier(0.4, 0, 1, 1)" },
      "spring":   { "value": "cubic-bezier(0.34, 1.56, 0.64, 1)", "comment": "Slight overshoot — the lock snap, the value pop." }
    }
  },

  "size": {
    "tapTarget": { "value": 44, "comment": "Minimum interactive target (a11y)." },
    "card": { "ratio": { "value": 0.714, "comment": "Pokémon card 63x88mm → width/height." } }
  }
}
